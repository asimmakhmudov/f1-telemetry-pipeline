    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "SessionKey",
        "min_value": 200001011,
        "max_value": 209912319
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "DriverNumber",
        "min_value": 1,
        "max_value": 99
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "LapNumber",
        "min_value": 1,
        "max_value": 100
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "LaneDuration",
        "min_value": 10,
        "max_value": 60
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "StopDuration",
        "min_value": 1.5,
        "max_value": 30
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_compound_columns_to_be_unique",
      "kwargs": {
        "column_list": [
          "SessionKey",
          "DriverNumber",
          "LapNumber"
        ]
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_pair_values_a_to_be_greater_than_b",
      "kwargs": {
        "column_A": "LaneDuration",
        "column_B": "StopDuration",
        "or_equal": false,
        "ignore_row_if": "either_value_is_missing"
      },
      "meta": {
        "notes": "Time stationary is part of the pit-lane time."
      }
    }
  ]
