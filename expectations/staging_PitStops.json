      "kwargs": {
        "column": "DriverNumber"
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "LapNumber"
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "LoadTimestamp"
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "LaneDuration",
        "mostly": 0.9
      },
      "meta": {
        "notes": "Measures may be NULL (unknown), but more than 10% missing in one batch means the source stopped sending this column."
      }
