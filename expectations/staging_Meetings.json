      "meta": {
        "notes": "Measures may be NULL (unknown), but more than 10% missing in one batch means the source stopped sending this column."
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "MeetingKey",
        "min_value": 20000101,
        "max_value": 20991231
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "Year",
        "min_value": 2000,
        "max_value": 2099
