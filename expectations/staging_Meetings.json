        "value_set": [
          "Permanent",
          "Temporary - Street",
          "Temporary - Road",
          "Unknown"
        ]
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": {
