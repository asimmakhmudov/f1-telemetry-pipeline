# Run `make env` to create .env from this file. Blank values get a default
# username or a random password/key.

# Source: PostgreSQL. The owner role is used only by the bootstrap and the generator;
# the pipeline reads with the read-only role, which the bootstrap creates.
SOURCE_DB_HOST=source-db
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=f1_telemetry
SOURCE_DB_USER=f1_owner
SOURCE_DB_PASSWORD=
SOURCE_DB_SSLMODE=prefer
SOURCE_READER_USER=etl_reader
SOURCE_READER_PASSWORD=

# Warehouse: DuckDB file on the warehouse-data volume. Superset reads the BI copy.
DUCKDB_PATH=/data/f1.duckdb
DUCKDB_BI_PATH=/data/f1_bi.duckdb
DUCKDB_MEMORY_LIMIT=1GB
DUCKDB_THREADS=2
DUCKDB_TEMP_DIR=/data/duckdb-tmp

# Extract
PIPELINE_SPILL_DIR=/data/spill
EXTRACT_FETCH_ROWS=50000
EXTRACT_LOOKBACK_MINUTES=5
VALIDATE_CHUNK_ROWS=200000

# Lake: SeaweedFS over the S3 API. The lake container is configured with this key pair.
LAKE_ACCESS_KEY=
LAKE_SECRET_KEY=
LAKE_BUCKET=f1-lake
LAKE_ENDPOINT=http://lake:8333

# Airflow
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=
AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_DB_USER=
AIRFLOW_DB_PASSWORD=
AIRFLOW_DB_NAME=

# Spark (local mode inside the Airflow containers)
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=1g
SPARK_LOCAL_DIR=/data/spark-tmp
SPARK_SHUFFLE_PARTITIONS=8

# Monitoring
PUSHGATEWAY_URL=pushgateway:9091
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Superset
SUPERSET_ADMIN_USER=
SUPERSET_ADMIN_PASSWORD=
SUPERSET_SECRET_KEY=
